  "cards": [
    {
      "id": "hacks-dialogue-03",
      "scene": "客户要求经纪人处理问题，经纪人提出一个新办法。",
      "purpose": "要求行动 → 答应处理 → 提出建议。",
      "hints": [
        {
          "expression": "do something about…",
          "meaning": "采取行动处理……"
        },
        {
          "expression": "What if you…?",
          "meaning": "要不你……？"
        }
      ],
      "turns": [
        {
          "speaker": "客户",
          "text": "You gotta do something about this, Jimmy.",
          "translation": "你得处理这件事，Jimmy。"
        },
        {
          "speaker": "经纪人",
          "text": "Okay, I will call Marty.",
          "translation": "好，我会给 Marty 打电话。"
        },
        {
          "speaker": "客户",
          "text": "Marty?",
          "translation": "Marty？"
        },
        {
          "speaker": "经纪人",
          "text": "Marty, yes. But um, I have a pitch.",
          "translation": "对，Marty。不过，呃，我有个提议。"
        },
        {
          "speaker": "经纪人",
          "text": "What if you hire a writer?",
          "translation": "要不你雇个编剧呢？"
        }
      ],
      "notes": "You gotta… 语气直接，适合熟人或有明确工作关系的场景。What if you…? 用来提出一个可考虑的办法。",
      "audio": "audio/hacks/five-02.mp3",
